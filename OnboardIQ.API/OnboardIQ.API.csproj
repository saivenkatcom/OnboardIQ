    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnboardIQ.Core\OnboardIQ.Core.csproj" />
    <ProjectReference Include="..\OnboardIQ.Infrastructure\OnboardIQ.Infrastructure.csproj" />
  </ItemGroup>

